<resources>
    <style name="Theme.ModuleLab" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/module_lab_primary</item>
        <item name="colorOnPrimary">@color/module_lab_on_primary</item>
        <item name="colorPrimaryContainer">@color/module_lab_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/module_lab_on_primary_container</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
