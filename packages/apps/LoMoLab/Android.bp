android_app {
    name: "LoMoLab",
    defaults: ["platform_app_defaults"],
    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
    ],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    privileged: true,
    platform_apis: true,
    product_specific: true,
    static_libs: [
        "androidx.core_core",
        "androidx.appcompat_appcompat",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "com.google.android.material_material",
    ],
    required: [
        "privapp_whitelist_org.lomolab.settings",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_org.lomolab.settings",
    product_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-org.lomolab.settings.xml",
    filename_from_src: true,
}
