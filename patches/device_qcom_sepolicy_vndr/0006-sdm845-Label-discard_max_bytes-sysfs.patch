diff --git a/generic/vendor/sdm845/genfs_contexts b/generic/vendor/sdm845/genfs_contexts
index 4a24696..50563b1 100644
--- a/generic/vendor/sdm845/genfs_contexts
+++ b/generic/vendor/sdm845/genfs_contexts
@@ -108,3 +108,7 @@
 genfscon sysfs /devices/platform/soc/c440000.qcom,spmi/spmi-0/spmi0-02/c440000.qcom,spmi:qcom,pmi8998@2:qpnp,fg/power_supply/bms/wakeup u:object_r:sysfs_wakeup:s0
