From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LoMo <lomo@colomovo.com>
Date: Sat, 12 Sep 2026 10:20:00 +0800
Subject: [PATCH] overlay: Add Chinese font families to fonts_customization.xml

Add font family and alias declarations for all 11 Chinese font families
so they can be cleanly selected via font overlays without duplicate install rules.

Change-Id: I9a375460b2586c3e6e511e72570efc9bd6bc2026
Signed-off-by: LoMo <lomo@colomovo.com>
---
 fonts/etc/fonts_customization.xml | 80 +++++++++++++++++++++++++++++++
 1 file changed, 80 insertions(+)

diff --git a/fonts/etc/fonts_customization.xml b/fonts/etc/fonts_customization.xml
index 8bf4f96..e4c19bd 100644
--- a/fonts/etc/fonts_customization.xml
+++ b/fonts/etc/fonts_customization.xml
@@ -1,3 +1,83 @@
 <?xml version="1.0" encoding="utf-8"?>
+<!--
+    Copyright (C) 2026 The AviumUI Project
+    SPDX-License-Identifier: Apache-2.0
+-->
 <fonts-modification version="1">
+    <!-- 得意黑 (Smiley Sans) - 现代几何黑体 -->
+    <family customizationType="new-named-family" name="smiley-sans">
+        <font weight="400" style="normal">SmileySans-Oblique.ttf</font>
+    </family>
+    <alias name="smiley-sans-medium" to="smiley-sans" weight="500" />
+    <alias name="smiley-sans-bold" to="smiley-sans" weight="700" />
+
+    <!-- 霞鹜文楷 (LXGW WenKai) - 文艺楷体 -->
+    <family customizationType="new-named-family" name="lxgw-wenkai">
+        <font weight="400" style="normal">LXGWWenKaiLite-Regular.ttf</font>
+    </family>
+    <alias name="lxgw-wenkai-medium" to="lxgw-wenkai" weight="500" />
+    <alias name="lxgw-wenkai-bold" to="lxgw-wenkai" weight="700" />
+
+    <!-- 霞鹜新晰黑 (LXGW Neo XiHei) - 极简 UI 黑体 -->
+    <family customizationType="new-named-family" name="lxgw-neoxihei">
+        <font weight="400" style="normal">LXGWNeoXiHei.ttf</font>
+    </family>
+    <alias name="lxgw-neoxihei-medium" to="lxgw-neoxihei" weight="500" />
+    <alias name="lxgw-neoxihei-bold" to="lxgw-neoxihei" weight="700" />
+
+    <!-- 小赖圆体 (Xiaolai Rounded) - 温暖圆体 -->
+    <family customizationType="new-named-family" name="xiaolai-rounded">
+        <font weight="400" style="normal">Xiaolai-Regular.ttf</font>
+    </family>
+    <alias name="xiaolai-rounded-medium" to="xiaolai-rounded" weight="500" />
+    <alias name="xiaolai-rounded-bold" to="xiaolai-rounded" weight="700" />
+
+    <!-- 思源宋体 (Noto Serif SC) - 典雅宋体/明朝体 -->
+    <family customizationType="new-named-family" name="noto-serif-sc">
+        <font weight="400" style="normal">NotoSerifSC.ttf</font>
+    </family>
+    <alias name="noto-serif-sc-medium" to="noto-serif-sc" weight="500" />
+    <alias name="noto-serif-sc-bold" to="noto-serif-sc" weight="700" />
+
+    <!-- 站酷庆科黄油体 (ZCOOL QingKe HuangYou) - 醒目圆角标题体 -->
+    <family customizationType="new-named-family" name="zcool-qingke-huangyou">
+        <font weight="400" style="normal">ZCOOLQingKeHuangYou-Regular.ttf</font>
+    </family>
+    <alias name="zcool-qingke-huangyou-medium" to="zcool-qingke-huangyou" weight="500" />
+    <alias name="zcool-qingke-huangyou-bold" to="zcool-qingke-huangyou" weight="700" />
+
+    <!-- 站酷小薇体 (ZCOOL XiaoWei) - 纤细秀丽清雅体 -->
+    <family customizationType="new-named-family" name="zcool-xiaowei">
+        <font weight="400" style="normal">ZCOOLXiaoWei-Regular.ttf</font>
+    </family>
+    <alias name="zcool-xiaowei-medium" to="zcool-xiaowei" weight="500" />
+    <alias name="zcool-xiaowei-bold" to="zcool-xiaowei" weight="700" />
+
+    <!-- 站酷快乐体 (ZCOOL KuaiLe) - 活泼明快趣味体 -->
+    <family customizationType="new-named-family" name="zcool-kuaile">
+        <font weight="400" style="normal">ZCOOLKuaiLe-Regular.ttf</font>
+    </family>
+    <alias name="zcool-kuaile-medium" to="zcool-kuaile" weight="500" />
+    <alias name="zcool-kuaile-bold" to="zcool-kuaile" weight="700" />
+
+    <!-- 马善政毛笔体 (Ma Shan Zheng) - 奔放写意毛笔体 -->
+    <family customizationType="new-named-family" name="mashanzheng">
+        <font weight="400" style="normal">MaShanZheng-Regular.ttf</font>
+    </family>
+    <alias name="mashanzheng-medium" to="mashanzheng" weight="500" />
+    <alias name="mashanzheng-bold" to="mashanzheng" weight="700" />
+
+    <!-- 龙藏体 (Long Cang) - 潇洒连笔行书 -->
+    <family customizationType="new-named-family" name="longcang">
+        <font weight="400" style="normal">LongCang-Regular.ttf</font>
+    </family>
+    <alias name="longcang-medium" to="longcang" weight="500" />
+    <alias name="longcang-bold" to="longcang" weight="700" />
+
+    <!-- 志莽行书 (Zhi Mang Xing) - 狂放连笔草书行书 -->
+    <family customizationType="new-named-family" name="zhimangxing">
+        <font weight="400" style="normal">ZhiMangXing-Regular.ttf</font>
+    </family>
+    <alias name="zhimangxing-medium" to="zhimangxing" weight="500" />
+    <alias name="zhimangxing-bold" to="zhimangxing" weight="700" />
 </fonts-modification>
-- 
2.48.1
