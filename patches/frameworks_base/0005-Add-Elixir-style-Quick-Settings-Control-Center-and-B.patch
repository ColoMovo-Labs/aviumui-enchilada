+package org.avium.systemui.controlcenter.ui
+
+import android.content.Context
+import android.util.AttributeSet
+import android.view.ViewGroup
+import android.widget.GridLayout
+import com.android.systemui.plugins.qs.QSTile
+import com.android.systemui.qs.QSHost
+
+class ElixirTilesGridView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0
+) : GridLayout(context, attrs, defStyleAttr) {
+
+    private var host: QSHost? = null
+    private val primarySpecs = setOf("internet", "wifi", "cell", "bt", "flashlight")
+
+    private val hostCallback = QSHost.Callback {
+        post { updateTiles() }
+    }
+
+    init {
+        columnCount = 2
+        layoutParams = ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+        useDefaultMargins = false
+        alignmentMode = ALIGN_BOUNDS
+    }
+
+    fun setHost(qsHost: QSHost?) {
+        host?.removeCallback(hostCallback)
+        host = qsHost
+        host?.addCallback(hostCallback)
+        updateTiles()
+    }
+
+    fun updateTiles() {
+        removeAllViews()
+        val h = host ?: return
+        val tiles = h.tiles.filter { !primarySpecs.contains(it.tileSpec) }
+
+        for ((index, tile) in tiles.withIndex()) {
+            val tileView = ElixirSecondaryTileView(context)
+            tileView.bindTile(tile)
+
+            val row = index / 2
+            val col = index % 2
+            val params = LayoutParams(
+                spec(row, 1f),
+                spec(col, 1f)
+            ).apply {
+                width = 0
+                height = dpToPx(66)
+                topMargin = dpToPx(4)
+                bottomMargin = dpToPx(4)
+                leftMargin = if (col == 0) 0 else dpToPx(4)
+                rightMargin = if (col == 1) 0 else dpToPx(4)
+            }
+            addView(tileView, params)
+        }
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        host?.removeCallback(hostCallback)
+    }
+
+    private fun dpToPx(dp: Int): Int = (dp * resources.displayMetrics.density).toInt()
+}

