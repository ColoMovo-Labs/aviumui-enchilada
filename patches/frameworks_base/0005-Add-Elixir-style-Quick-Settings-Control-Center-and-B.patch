     private QSCustomizer mQSCustomizer;
     private QSPanel mQSPanel;
     private NonInterceptingScrollView mQSPanelContainer;
+    private org.avium.systemui.controlcenter.ElixirControlCenterView mElixirControlCenter;
+    private int mControlCenterStyle = 0;
 
     private int mHorizontalMargins;
     private int mTilesPageMargin;
@@ -78,9 +80,43 @@ public class QSContainerImpl extends FrameLayout implements Dumpable {
         mQSPanel = findViewById(R.id.quick_settings_panel);
         mHeader = findViewById(R.id.header);
         mQSCustomizer = findViewById(R.id.qs_customize);
+        mElixirControlCenter = findViewById(R.id.elixir_control_center);
         setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
     }
 
+    public org.avium.systemui.controlcenter.ElixirControlCenterView getElixirControlCenter() {
+        return mElixirControlCenter;
+    }
+
+    public void setControlCenterStyle(int style) {
+        if (mControlCenterStyle == style) return;
+        mControlCenterStyle = style;
+        updateStyleVisibility();
+    }
+
+    public int getControlCenterStyle() {
+        return mControlCenterStyle;
+    }
+
+    private void updateStyleVisibility() {
+        if (mElixirControlCenter == null) return;
+        boolean isElixir = (mControlCenterStyle == 1);
+        if (isElixir) {
+            if (mQSPanelContainer != null) mQSPanelContainer.setVisibility(GONE);
+            if (mHeader != null) mHeader.setVisibility(GONE);
+            View footer = findViewById(R.id.qs_footer_actions);
+            if (footer != null) footer.setVisibility(GONE);
+            mElixirControlCenter.setVisibility(VISIBLE);
+        } else {
+            if (mQSPanelContainer != null) mQSPanelContainer.setVisibility(VISIBLE);
+            if (mHeader != null) mHeader.setVisibility(VISIBLE);
+            View footer = findViewById(R.id.qs_footer_actions);
+            if (footer != null) footer.setVisibility(VISIBLE);
+            mElixirControlCenter.setVisibility(GONE);
+        }
+        updateExpansion();
+    }
+
     void setSceneContainerEnabled(boolean enabled) {
         mSceneContainerEnabled = enabled;
         if (enabled) {
@@ -152,7 +188,7 @@ public class QSContainerImpl extends FrameLayout implements Dumpable {
             // This prevents the pages in PagedTileLayout to be remeasured with a different
             // (incorrect) size to the one used for determining the number of rows and then the
             // number of pages.
-            if (child != mQSPanelContainer) {
+            if (child != mQSPanelContainer && child != mElixirControlCenter) {
                 super.measureChildWithMargins(child, parentWidthMeasureSpec, widthUsed,
                         parentHeightMeasureSpec, heightUsed);
             }
@@ -242,6 +278,9 @@ public class QSContainerImpl extends FrameLayout implements Dumpable {
 
     protected int calculateContainerHeight() {
         int heightOverride = mHeightOverride != -1 ? mHeightOverride : getMeasuredHeight();
+        if (mControlCenterStyle == 1 && mElixirControlCenter != null) {
+            return Math.round(mQsExpansion * heightOverride);
+        }
         // Need to add the dragHandle height so touches will be intercepted by it.
         return mQSCustomizer.isCustomizing() ? mQSCustomizer.getHeight()
                 : Math.round(mQsExpansion * (heightOverride - mHeader.getHeight()))
@@ -287,6 +326,9 @@ public class QSContainerImpl extends FrameLayout implements Dumpable {
         if (mQSPanelContainer != null) {
             mQSPanelContainer.setScrollingEnabled(expansion > 0f);
         }
+        if (mElixirControlCenter != null && mControlCenterStyle == 1) {
+            mElixirControlCenter.setExpansion(expansion);
+        }
         updateExpansion();
     }
 
diff --git a/packages/SystemUI/src/com/android/systemui/qs/QSContainerImplController.java b/packages/SystemUI/src/com/android/systemui/qs/QSContainerImplController.java
