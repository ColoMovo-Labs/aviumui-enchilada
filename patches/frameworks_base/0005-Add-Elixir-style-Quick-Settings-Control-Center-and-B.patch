+package org.avium.systemui.controlcenter
+
+import android.content.Context
+import android.database.ContentObserver
+import android.net.Uri
+import android.os.Handler
+import android.os.Looper
+import android.os.UserHandle
+import android.provider.Settings
+import com.android.systemui.dagger.SysUISingleton
+import java.util.concurrent.CopyOnWriteArrayList
+import javax.inject.Inject
+
+@SysUISingleton
+class ControlCenterSettings @Inject constructor(
+    private val context: Context
+) {
+    companion object {
+        const val KEY_CONTROL_CENTER_STYLE = "avium_control_center_style" // 0: Avium, 1: Elixir
+        const val KEY_CONTROL_CENTER_BLUR = "avium_control_center_blur" // 0: off, 1: on
+        const val KEY_CONTROL_CENTER_BLUR_INTENSITY = "avium_control_center_blur_intensity" // 0: 15px, 1: 30px, 2: 60px
+
+        const val STYLE_AVIUM = 0
+        const val STYLE_ELIXIR = 1
+
+        const val BLUR_LOW_PX = 15
+        const val BLUR_MEDIUM_PX = 30
+        const val BLUR_HIGH_PX = 60
+
+        fun isElixirStyle(context: Context): Boolean {
+            return Settings.System.getIntForUser(
+                context.contentResolver,
+                KEY_CONTROL_CENTER_STYLE,
+                STYLE_AVIUM,
+                UserHandle.USER_CURRENT
+            ) == STYLE_ELIXIR
+        }
+
+        fun isBlurEnabled(context: Context): Boolean {
+            return Settings.System.getIntForUser(
+                context.contentResolver,
+                KEY_CONTROL_CENTER_BLUR,
+                1,
+                UserHandle.USER_CURRENT
+            ) == 1
+        }
+
+        fun getBlurRadiusPx(context: Context): Int {
+            return when (Settings.System.getIntForUser(
+                context.contentResolver,
+                KEY_CONTROL_CENTER_BLUR_INTENSITY,
+                0, // Default to Low (15px) to guarantee 60Hz fluidity on SDM845
+                UserHandle.USER_CURRENT
+            )) {
+                0 -> BLUR_LOW_PX
+                1 -> BLUR_MEDIUM_PX
+                2 -> BLUR_HIGH_PX
+                else -> BLUR_LOW_PX
+            }
+        }
+    }
+
+    private val resolver = context.contentResolver
+    private val listeners = CopyOnWriteArrayList<() -> Unit>()
+
+    private val observer = object : ContentObserver(Handler(Looper.getMainLooper())) {
+        override fun onChange(selfChange: Boolean, uri: Uri?) {
+            listeners.forEach { it.invoke() }
+        }
+    }
+
+    fun start() {
+        registerKey(KEY_CONTROL_CENTER_STYLE)
+        registerKey(KEY_CONTROL_CENTER_BLUR)
+        registerKey(KEY_CONTROL_CENTER_BLUR_INTENSITY)
+    }
+
+    private fun registerKey(key: String) {
+        val uri = Settings.System.getUriFor(key) ?: return
+        resolver.registerContentObserver(uri, false, observer, UserHandle.USER_ALL)
+    }
+
+    fun addListener(listener: () -> Unit) {
+        listeners.add(listener)
+    }
+
+    fun removeListener(listener: () -> Unit) {
+        listeners.remove(listener)
+    }
+
+    val isElixirStyle: Boolean
+        get() = isElixirStyle(context)
+
+    val isBlurEnabled: Boolean
+        get() = isBlurEnabled(context)
+
+    val blurRadiusPx: Int
+        get() = getBlurRadiusPx(context)
+}
