+    private final android.database.ContentObserver mStyleObserver =
+            new android.database.ContentObserver(new android.os.Handler(android.os.Looper.getMainLooper())) {
+        @Override
+        public void onChange(boolean selfChange) {
+            updateControlCenterStyle();
+        }
+    };
+
+    private void updateControlCenterStyle() {
+        if (mView != null && mView.getElixirControlCenter() != null) {
+            int style = android.provider.Settings.System.getIntForUser(
+                    getContext().getContentResolver(),
+                    "avium_control_center_style",
+                    0,
+                    android.os.UserHandle.USER_CURRENT);
+            mView.setControlCenterStyle(style);
+        }
+    }
+
     public void setListening(boolean listening) {
         mQuickStatusBarHeaderController.setListening(listening);
+        if (mView != null && mView.getElixirControlCenter() != null) {
+            mView.getElixirControlCenter().setListening(listening);
+        }
     }
 
     @Override
@@ -97,6 +119,18 @@ public class QSContainerImplController extends ViewController<QSContainerImpl> {
         if (!mSceneContainerEnabled && mQSPanelContainer != null) {
             mQSPanelContainer.setOnTouchListener(mContainerTouchHandler);
         }
+        if (mView.getElixirControlCenter() != null) {
+            mView.getElixirControlCenter().init(
+                    mQsPanelController.getHost(),
+                    mQsPanelController.getBrightnessControllerFactory(),
+                    mQsPanelController.getCustomizerController());
+            updateControlCenterStyle();
+            getContext().getContentResolver().registerContentObserver(
+                    android.provider.Settings.System.getUriFor("avium_control_center_style"),
+                    false,
+                    mStyleObserver,
+                    android.os.UserHandle.USER_ALL);
+        }
     }
 
     @Override
@@ -105,6 +139,7 @@ public class QSContainerImplController extends ViewController<QSContainerImpl> {
         if (mQSPanelContainer != null) {
             mQSPanelContainer.setOnTouchListener(null);
         }
+        getContext().getContentResolver().unregisterContentObserver(mStyleObserver);
     }
 
     public QSContainerImpl getView() {
