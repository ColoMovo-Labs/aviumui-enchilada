+import android.view.WindowInsets
+import android.widget.FrameLayout
+import android.widget.ImageButton
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextClock
+import android.widget.TextView
+import com.android.internal.graphics.drawable.BackgroundBlurDrawable
+import com.android.systemui.plugins.qs.QSTile
+import com.android.systemui.qs.NonInterceptingScrollView
+import com.android.systemui.qs.QSHost
+import com.android.systemui.qs.customize.QSCustomizerController
+import com.android.systemui.res.R
+import com.android.systemui.settings.brightness.BrightnessController
+import org.avium.systemui.controlcenter.ui.ElixirBrightnessSliderView
+import org.avium.systemui.controlcenter.ui.ElixirMediaCardView
+import org.avium.systemui.controlcenter.ui.ElixirPrimaryCardView
+import org.avium.systemui.controlcenter.ui.ElixirTilesGridView
+import org.avium.systemui.island.IslandController
+
+class ElixirControlCenterView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0
+) : FrameLayout(context, attrs, defStyleAttr) {
+
+    private val scrollView: NonInterceptingScrollView
+    private val contentLayout: LinearLayout
+
+    // Header
+    private val headerLayout: LinearLayout
+    private val clockView: TextClock
+    private val dateView: TextClock
+    private val btnSettings: ImageButton
+    private val btnEdit: ImageButton
+    private val btnPower: ImageButton
+
+    // Primary Cards
+    private val primaryRow1: LinearLayout
+    private val primaryRow2: LinearLayout
+    private val wifiCard: ElixirPrimaryCardView
+    private val cellCard: ElixirPrimaryCardView
+    private val btCard: ElixirPrimaryCardView
+    private val flashCard: ElixirPrimaryCardView
+
+    // Brightness Slider
+    private val brightnessSlider: ElixirBrightnessSliderView
+
+    // Media Card
+    private val mediaCard: ElixirMediaCardView
+
+    // Secondary Tiles Grid
+    private val secondaryGrid: ElixirTilesGridView
+
+    private var mHost: QSHost? = null
+    private var mBrightnessController: BrightnessController? = null
+    private var mCustomizerController: QSCustomizerController? = null
+
+    private var backgroundBlurDrawable: BackgroundBlurDrawable? = null
+
+    init {
+        layoutParams = LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT)
+        isClickable = true
+        isFocusable = true
+
+        scrollView = NonInterceptingScrollView(context).apply {
+            layoutParams = LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT)
+            isVerticalScrollBarEnabled = false
+            clipToPadding = false
+            clipChildren = false
+        }
+        addView(scrollView)
+
+        contentLayout = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            layoutParams = LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT)
+            clipToPadding = false
+            clipChildren = false
+        }
+        scrollView.addView(contentLayout)
+
+        // 1. Header Row (Clock, Date, Action Buttons)
+        headerLayout = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            layoutParams = LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT).apply {
+                bottomMargin = dpToPx(14)
+            }
+        }
+
+        val clockDateCol = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+        }
+        clockView = TextClock(context).apply {
+            format12Hour = "h:mm"
+            format24Hour = "HH:mm"
+            setTextColor(Color.WHITE)
+            textSize = 28f
+            typeface = android.graphics.Typeface.DEFAULT_BOLD
+        }
+        clockDateCol.addView(clockView, LinearLayout.LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+
+        dateView = TextClock(context).apply {
+            format12Hour = "EEE, MMM d"
+            format24Hour = "EEE, MMM d"
+            setTextColor(Color.parseColor("#B3FFFFFF"))
+            textSize = 13f
+        }
+        clockDateCol.addView(dateView, LinearLayout.LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+        headerLayout.addView(clockDateCol, LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f))
+
+        // Header Buttons (Edit, Settings, Power)
+        val buttonsLayout = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+        }
+
+        btnEdit = createHeaderButton(R.drawable.ic_control_center_edit) {
+            mCustomizerController?.show(0, 0, false)
+        }
+        buttonsLayout.addView(btnEdit)
+
+        btnSettings = createHeaderButton(R.drawable.ic_control_center_settings) {
+            val intent = Intent(Settings.ACTION_SETTINGS).apply {
+                flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
+            }
+            context.startActivity(intent)
+            mHost?.collapsePanels()
+        }
+        buttonsLayout.addView(btnSettings)
+
+        btnPower = createHeaderButton(R.drawable.ic_control_center_power) {
+            val intent = Intent(Intent.ACTION_POWER_USAGE_SUMMARY).apply {
+                flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
+            }
+            try { context.startActivity(intent) } catch (ignored: Throwable) {}
+        }
+        buttonsLayout.addView(btnPower)
+
+        headerLayout.addView(buttonsLayout, LinearLayout.LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+        contentLayout.addView(headerLayout)
+
+        // 2. Primary Cards (2 Rows of 2 Cards)
+        primaryRow1 = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            layoutParams = LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT).apply {
+                bottomMargin = dpToPx(8)
+            }
+        }
+        wifiCard = ElixirPrimaryCardView(context)
+        cellCard = ElixirPrimaryCardView(context)
+        primaryRow1.addView(wifiCard, LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f).apply { marginEnd = dpToPx(4) })
+        primaryRow1.addView(cellCard, LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f).apply { marginStart = dpToPx(4) })
+        contentLayout.addView(primaryRow1)
+
+        primaryRow2 = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            layoutParams = LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT).apply {
+                bottomMargin = dpToPx(12)
+            }
+        }
+        btCard = ElixirPrimaryCardView(context)
+        flashCard = ElixirPrimaryCardView(context)
+        primaryRow2.addView(btCard, LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f).apply { marginEnd = dpToPx(4) })
+        primaryRow2.addView(flashCard, LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f).apply { marginStart = dpToPx(4) })
+        contentLayout.addView(primaryRow2)
+
+        // 3. Brightness Slider
+        brightnessSlider = ElixirBrightnessSliderView(context)
+        val sliderParams = LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT).apply {
+            bottomMargin = dpToPx(12)
+        }
+        contentLayout.addView(brightnessSlider, sliderParams)
+
+        // 4. Media Player Card
+        mediaCard = ElixirMediaCardView(context)
+        val mediaParams = LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT).apply {
+            bottomMargin = dpToPx(12)
+        }
+        contentLayout.addView(mediaCard, mediaParams)
+
+        // 5. Secondary Tiles Grid
+        secondaryGrid = ElixirTilesGridView(context)
+        val gridParams = LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT).apply {
+            bottomMargin = dpToPx(32)
+        }
+        contentLayout.addView(secondaryGrid, gridParams)
+    }
+
+    private fun createHeaderButton(iconResId: Int, onClick: () -> Unit): ImageButton {
+        return ImageButton(context).apply {
+            setImageResource(iconResId)
+            setColorFilter(Color.WHITE)
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.OVAL
+                setColor(Color.parseColor("#26FFFFFF"))
+            }
+            val size = dpToPx(38)
+            layoutParams = LinearLayout.LayoutParams(size, size).apply {
+                marginStart = dpToPx(8)
+            }
+            setPadding(dpToPx(8), dpToPx(8), dpToPx(8), dpToPx(8))
+            setOnClickListener { onClick() }
+        }
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        applyNotchPadding()
+        updateBlurEffect()
+    }
+
+    override fun onApplyWindowInsets(insets: WindowInsets): WindowInsets {
+        applyNotchPadding()
+        return super.onApplyWindowInsets(insets)
+    }
+
+    private fun applyNotchPadding() {
+        val statusBarRes = resources.getIdentifier("status_bar_height", "dimen", "android")
+        val statusBarHeight = if (statusBarRes > 0) resources.getDimensionPixelSize(statusBarRes) else dpToPx(48)
+        val cutoutTop = rootWindowInsets?.displayCutout?.safeInsetTop ?: 0
+        val topPadding = Math.max(statusBarHeight, cutoutTop) + dpToPx(12)
+        setPadding(dpToPx(16), topPadding, dpToPx(16), dpToPx(16))
+    }
+
+    fun updateBlurEffect() {
+        val supportsBlur = SystemProperties.getBoolean("ro.surface_flinger.supports_background_blur", false)
+        val blurEnabled = ControlCenterSettings.isBlurEnabled(context)
+        val blurRadius = ControlCenterSettings.getBlurRadiusPx(context)
+
+        if (supportsBlur && blurEnabled && viewRootImpl != null) {
+            if (backgroundBlurDrawable == null) {
+                backgroundBlurDrawable = viewRootImpl.createBackgroundBlurDrawable()
+            }
+            backgroundBlurDrawable?.let { blur ->
+                blur.setBlurRadius(blurRadius)
+                blur.setCornerRadius(0f)
+                val isDark = (resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES
+                val tintColor = if (isDark) Color.argb(160, 16, 16, 20) else Color.argb(140, 245, 245, 247)
+                blur.setColor(tintColor)
+                background = blur
+                return
+            }
+        }
+
+        val isDark = (resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES
+        val fallbackColor = if (isDark) Color.argb(235, 18, 18, 22) else Color.argb(235, 245, 245, 247)
+        setBackgroundColor(fallbackColor)
+    }
+
+    fun init(
+        host: QSHost?,
+        brightnessFactory: BrightnessController.Factory?,
+        customizerController: QSCustomizerController?
+    ) {
+        this.mHost = host
+        this.mCustomizerController = customizerController
+
+        if (brightnessFactory != null && mBrightnessController == null) {
+            mBrightnessController = brightnessFactory.create(brightnessSlider)
+        }
+
+        val tiles = host?.tiles ?: emptyList()
+        val wifiTile = tiles.find { it.tileSpec == "internet" || it.tileSpec == "wifi" }
+        val cellTile = tiles.find { it.tileSpec == "cell" || it.tileSpec == "hotspot" }
+        val btTile = tiles.find { it.tileSpec == "bt" }
+        val flashTile = tiles.find { it.tileSpec == "flashlight" }
+
+        wifiCard.bindTile(wifiTile, "Internet", R.drawable.ic_control_center_wifi)
+        cellCard.bindTile(cellTile, "Mobile Data", R.drawable.ic_control_center_cellular)
+        btCard.bindTile(btTile, "Bluetooth", R.drawable.ic_control_center_bluetooth)
+        flashCard.bindTile(flashTile, "Flashlight", R.drawable.ic_control_center_flashlight)
+
+        secondaryGrid.setHost(host)
+    }
+
+    fun setListening(listening: Boolean) {
+        if (listening) {
+            mBrightnessController?.registerCallbacks()
+        } else {
+            mBrightnessController?.unregisterCallbacks()
+        }
+    }
+
+    fun setExpansion(expansion: Float) {
+        if (expansion <= 0f) {
+            visibility = View.GONE
+            alpha = 0f
+            return
+        }
+
+        visibility = View.VISIBLE
+        alpha = (expansion * 1.5f).coerceIn(0f, 1f)
+        translationY = -(1f - expansion) * dpToPx(60)
+
+        if (expansion > 0.05f) {
+            IslandController.instance?.collapseIsland()
+        }
+    }
+
+    private fun dpToPx(dp: Int): Int = (dp * resources.displayMetrics.density).toInt()
+}
