+package org.avium.systemui.controlcenter
+
+import android.content.Context
+import com.android.systemui.CoreStartable
+import com.android.systemui.dagger.SysUISingleton
+import javax.inject.Inject
+
+@SysUISingleton
+class ControlCenterController @Inject constructor(
+    private val context: Context,
+    private val settings: ControlCenterSettings
+) : CoreStartable {
+
+    companion object {
+        var instance: ControlCenterController? = null
+            private set
+    }
+
+    init {
+        instance = this
+    }
+
+    override fun start() {
+        settings.start()
+    }
+}
