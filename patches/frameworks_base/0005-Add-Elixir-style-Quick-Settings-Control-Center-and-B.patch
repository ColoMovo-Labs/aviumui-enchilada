+    private val callback = object : QSTile.Callback {
+        override fun onStateChanged(state: QSTile.State) {
+            post { updateFromState(state) }
+        }
+    }
+
+    init {
+        layoutParams = LayoutParams(LayoutParams.MATCH_PARENT, dpToPx(74))
+        isClickable = true
+        isFocusable = true
+        setInactiveBackground()
+
+        val root = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(dpToPx(14), dpToPx(12), dpToPx(14), dpToPx(12))
+        }
+
+        iconContainer = FrameLayout(context).apply {
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.OVAL
+                setColor(Color.parseColor("#33FFFFFF"))
+            }
+        }
+        iconView = ImageView(context).apply {
+            setColorFilter(Color.WHITE)
+        }
+        val iconSize = dpToPx(24)
+        val iconLp = LayoutParams(iconSize, iconSize).apply {
+            gravity = Gravity.CENTER
+        }
+        iconContainer.addView(iconView, iconLp)
+
+        val containerSize = dpToPx(44)
+        root.addView(iconContainer, LinearLayout.LayoutParams(containerSize, containerSize))
+
+        val textLayout = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dpToPx(12), 0, 0, 0)
+        }
+
+        titleView = TextView(context).apply {
+            setTextColor(Color.WHITE)
+            textSize = 14f
+            typeface = android.graphics.Typeface.DEFAULT_BOLD
+            maxLines = 1
+            ellipsize = android.text.TextUtils.TruncateAt.END
+        }
+        textLayout.addView(titleView, LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+
+        subtitleView = TextView(context).apply {
+            setTextColor(Color.parseColor("#B3FFFFFF"))
+            textSize = 12f
+            maxLines = 1
+            ellipsize = android.text.TextUtils.TruncateAt.END
+        }
+        textLayout.addView(subtitleView, LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+
+        root.addView(textLayout, LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f))
+        addView(root, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
+    }
+
+    fun bindTile(tile: QSTile?, defaultTitle: String, defaultIconRes: Int) {
+        boundTile?.removeCallback(callback)
+        boundTile = tile
+        if (tile != null) {
+            tile.addCallback(callback)
+            updateFromState(tile.state)
+            setOnClickListener { tile.click(this) }
+            setOnLongClickListener {
+                tile.longClick(this)
+                true
+            }
+        } else {
+            titleView.text = defaultTitle
+            subtitleView.text = "Off"
+            iconView.setImageResource(defaultIconRes)
+            setInactiveBackground()
+        }
+    }
+
+    private fun updateFromState(state: QSTile.State) {
+        titleView.text = state.label ?: ""
+        subtitleView.text = state.secondaryLabel ?: (if (state.state == Tile.STATE_ACTIVE) "On" else "Off")
+        val d = state.icon?.getDrawable(context)
+        if (d != null) {
+            iconView.setImageDrawable(d)
+        }
+        if (state.state == Tile.STATE_ACTIVE) {
+            setActiveBackground()
+        } else {
+            setInactiveBackground()
+        }
+    }
+
+    private fun setActiveBackground() {
+        val accent = getAccentColor()
+        background = GradientDrawable().apply {
+            cornerRadius = dpToPx(20).toFloat()
+            setColor(accent)
+        }
+        (iconContainer.background as? GradientDrawable)?.setColor(Color.argb(60, 255, 255, 255))
+        iconView.setColorFilter(Color.WHITE)
+        titleView.setTextColor(Color.WHITE)
+        subtitleView.setTextColor(Color.parseColor("#E6FFFFFF"))
+    }
+
+    private fun setInactiveBackground() {
+        background = GradientDrawable().apply {
+            cornerRadius = dpToPx(20).toFloat()
+            setColor(Color.parseColor("#26FFFFFF"))
+            setStroke(dpToPx(1), Color.parseColor("#1FFFFFFF"))
+        }
+        (iconContainer.background as? GradientDrawable)?.setColor(Color.parseColor("#26FFFFFF"))
+        iconView.setColorFilter(Color.WHITE)
+        titleView.setTextColor(Color.WHITE)
+        subtitleView.setTextColor(Color.parseColor("#99FFFFFF"))
+    }
+
+    private fun getAccentColor(): Int {
+        val typedValue = android.util.TypedValue()
+        if (context.theme.resolveAttribute(android.R.attr.colorAccent, typedValue, true)) {
+            return typedValue.data
+        }
+        return Color.parseColor("#FF4F8DF7")
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        boundTile?.removeCallback(callback)
+    }
+
+    private fun dpToPx(dp: Int): Int = (dp * resources.displayMetrics.density).toInt()
+}
