+package org.avium.systemui.controlcenter.ui
+
+import android.content.Context
+import android.graphics.Color
+import android.graphics.drawable.GradientDrawable
+import android.util.AttributeSet
+import android.view.Gravity
+import android.view.HapticFeedbackConstants
+import android.view.MotionEvent
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.TextView
+import com.android.settingslib.RestrictedLockUtils
+import com.android.systemui.res.R
+import com.android.systemui.settings.brightness.MirrorController
+import com.android.systemui.settings.brightness.ToggleSlider
+
+class ElixirBrightnessSliderView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0
+) : FrameLayout(context, attrs, defStyleAttr), ToggleSlider {
+
+    private var mListener: ToggleSlider.Listener? = null
+    private var mMax: Int = 10000
+    private var mValue: Int = 0
+    private var isTracking: Boolean = false
+
+    private val backgroundTrack: View
+    private val progressFill: View
+    private val sunIcon: ImageView
+    private val percentText: TextView
+    private val fillDrawable: GradientDrawable
+
+    init {
+        layoutParams = LayoutParams(LayoutParams.MATCH_PARENT, dpToPx(50))
+        isClickable = true
+        isFocusable = true
+
+        backgroundTrack = View(context).apply {
+            background = GradientDrawable().apply {
+                setColor(Color.parseColor("#33FFFFFF"))
+                cornerRadius = dpToPx(25).toFloat()
+                setStroke(dpToPx(1), Color.parseColor("#26FFFFFF"))
+            }
+        }
+        addView(backgroundTrack, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
+
+        fillDrawable = GradientDrawable().apply {
+            val accent = getAccentColor()
+            setColor(accent)
+            cornerRadius = dpToPx(25).toFloat()
+        }
+        progressFill = View(context).apply {
+            background = fillDrawable
+        }
+        addView(progressFill, LayoutParams(0, LayoutParams.MATCH_PARENT))
+
+        sunIcon = ImageView(context).apply {
+            setImageResource(R.drawable.ic_brightness_slider_sun)
+            setColorFilter(Color.WHITE)
+        }
+        val iconParams = LayoutParams(dpToPx(22), dpToPx(22)).apply {
+            gravity = Gravity.CENTER_VERTICAL or Gravity.START
+            marginStart = dpToPx(16)
+        }
+        addView(sunIcon, iconParams)
+
+        percentText = TextView(context).apply {
+            setTextColor(Color.WHITE)
+            textSize = 13f
+            typeface = android.graphics.Typeface.DEFAULT_BOLD
+            gravity = Gravity.CENTER_VERTICAL or Gravity.END
+            text = "0%"
+        }
+        val textParams = LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT).apply {
+            gravity = Gravity.CENTER_VERTICAL or Gravity.END
+            marginEnd = dpToPx(16)
+        }
+        addView(percentText, textParams)
+    }
+
+    private fun getAccentColor(): Int {
+        val typedValue = android.util.TypedValue()
+        if (context.theme.resolveAttribute(android.R.attr.colorAccent, typedValue, true)) {
+            return typedValue.data
+        }
+        return Color.parseColor("#FF4F8DF7")
+    }
+
+    override fun onLayout(changed: Boolean, left: Int, top: Int, right: Int, bottom: Int) {
+        super.onLayout(changed, left, top, right, bottom)
+        updateProgressWidth()
+    }
+
+    private fun updateProgressWidth() {
+        val totalWidth = width
+        if (totalWidth <= 0 || mMax <= 0) return
+        val fraction = (mValue.toFloat() / mMax).coerceIn(0f, 1f)
+        val fillWidth = (totalWidth * fraction).toInt().coerceAtLeast(if (fraction > 0f) dpToPx(24) else 0)
+        val lp = progressFill.layoutParams
+        if (lp.width != fillWidth) {
+            lp.width = fillWidth
+            progressFill.layoutParams = lp
+        }
+        val pct = (fraction * 100).toInt()
+        percentText.text = "$pct%"
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                isTracking = true
+                parent?.requestDisallowInterceptTouchEvent(true)
+                performHapticFeedback(HapticFeedbackConstants.CLOCK_TICK)
+                handleTouchPosition(event.x)
+                mListener?.onChanged(true, mValue, false)
+                return true
+            }
+            MotionEvent.ACTION_MOVE -> {
+                handleTouchPosition(event.x)
+                mListener?.onChanged(true, mValue, false)
+                return true
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                isTracking = false
+                parent?.requestDisallowInterceptTouchEvent(false)
+                handleTouchPosition(event.x)
+                mListener?.onChanged(false, mValue, true)
+                return true
+            }
+        }
+        return super.onTouchEvent(event)
+    }
+
+    private fun handleTouchPosition(x: Float) {
+        val totalWidth = width.toFloat()
+        if (totalWidth <= 0f) return
+        val fraction = (x / totalWidth).coerceIn(0f, 1f)
+        val newValue = (fraction * mMax).toInt()
+        if (newValue != mValue) {
+            mValue = newValue
+            updateProgressWidth()
+        }
+    }
+
+    override fun setEnforcedAdmin(admin: RestrictedLockUtils.EnforcedAdmin?) {}
+    override fun setMirrorControllerAndMirror(c: MirrorController?) {}
+    override fun mirrorTouchEvent(ev: MotionEvent?): Boolean = false
+    override fun setOnChangedListener(l: ToggleSlider.Listener?) { mListener = l }
+    override fun setMax(max: Int) {
+        mMax = max
+        updateProgressWidth()
+    }
+    override fun getMax(): Int = mMax
+    override fun setValue(value: Int) {
+        if (!isTracking && mValue != value) {
+            mValue = value
+            post { updateProgressWidth() }
+        }
+    }
+    override fun getValue(): Int = mValue
+    override fun showView() { visibility = View.VISIBLE }
+    override fun hideView() { visibility = View.GONE }
+    override fun showToast(resId: Int) {}
+    override fun isVisible(): Boolean = visibility == View.VISIBLE
+
+    private fun dpToPx(dp: Int): Int = (dp * resources.displayMetrics.density).toInt()
+}
