+
+class ElixirMediaCardView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0
+) : FrameLayout(context, attrs, defStyleAttr) {
+
+    private val albumArt: ImageView
+    private val titleText: TextView
+    private val artistText: TextView
+    private val btnPrev: ImageButton
+    private val btnPlayPause: ImageButton
+    private val btnNext: ImageButton
+    private val placeholderLayout: LinearLayout
+    private val mediaContentLayout: LinearLayout
+
+    private var currentEvent: IslandEvent? = null
+
+    private val mediaListener: (IslandEvent?) -> Unit = { event ->
+        post { bindMediaEvent(event) }
+    }
+
+    init {
+        layoutParams = LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT)
+        updateCardBackground()
+
+        val rootLayout = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dpToPx(14), dpToPx(12), dpToPx(14), dpToPx(12))
+        }
+        addView(rootLayout, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+
+        placeholderLayout = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            visibility = View.VISIBLE
+        }
+        val noteIcon = ImageView(context).apply {
+            setImageResource(R.drawable.ic_control_center_music)
+            setColorFilter(Color.parseColor("#99FFFFFF"))
+        }
+        placeholderLayout.addView(noteIcon, LayoutParams(dpToPx(24), dpToPx(24)))
+
+        val placeholderText = TextView(context).apply {
+            text = "No media playing"
+            setTextColor(Color.parseColor("#99FFFFFF"))
+            textSize = 13f
+            setPadding(dpToPx(12), 0, 0, 0)
+        }
+        placeholderLayout.addView(placeholderText, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+        rootLayout.addView(placeholderLayout, LayoutParams(LayoutParams.MATCH_PARENT, dpToPx(44)))
+
+        mediaContentLayout = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            visibility = View.GONE
+        }
+
+        albumArt = ImageView(context).apply {
+            scaleType = ImageView.ScaleType.CENTER_CROP
+            background = GradientDrawable().apply {
+                cornerRadius = dpToPx(10).toFloat()
+                setColor(Color.parseColor("#33FFFFFF"))
+            }
+            clipToOutline = true
+        }
+        mediaContentLayout.addView(albumArt, LayoutParams(dpToPx(48), dpToPx(48)))
+
+        val textColumn = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dpToPx(12), 0, dpToPx(8), 0)
+        }
+        titleText = TextView(context).apply {
+            setTextColor(Color.WHITE)
+            textSize = 14f
+            typeface = android.graphics.Typeface.DEFAULT_BOLD
+            maxLines = 1
+            ellipsize = android.text.TextUtils.TruncateAt.END
+        }
+        textColumn.addView(titleText, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+
+        artistText = TextView(context).apply {
+            setTextColor(Color.parseColor("#B3FFFFFF"))
+            textSize = 12f
+            maxLines = 1
+            ellipsize = android.text.TextUtils.TruncateAt.END
+        }
+        textColumn.addView(artistText, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+        mediaContentLayout.addView(textColumn, LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f))
+
+        val controlsLayout = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+        }
+
+        btnPrev = ImageButton(context).apply {
+            setImageResource(R.drawable.ic_control_center_prev)
+            setColorFilter(Color.WHITE)
+            background = null
+            setPadding(dpToPx(4), dpToPx(4), dpToPx(4), dpToPx(4))
+        }
+        controlsLayout.addView(btnPrev, LayoutParams(dpToPx(32), dpToPx(32)))
+
+        btnPlayPause = ImageButton(context).apply {
+            setImageResource(R.drawable.ic_control_center_play)
+            setColorFilter(Color.WHITE)
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.OVAL
+                setColor(Color.parseColor("#4DFFFFFF"))
+            }
+            setPadding(dpToPx(6), dpToPx(6), dpToPx(6), dpToPx(6))
+        }
+        val playParams = LayoutParams(dpToPx(38), dpToPx(38)).apply {
+            marginStart = dpToPx(4)
+            marginEnd = dpToPx(4)
+        }
+        controlsLayout.addView(btnPlayPause, playParams)
+
+        btnNext = ImageButton(context).apply {
+            setImageResource(R.drawable.ic_control_center_next)
+            setColorFilter(Color.WHITE)
+            background = null
+            setPadding(dpToPx(4), dpToPx(4), dpToPx(4), dpToPx(4))
+        }
+        controlsLayout.addView(btnNext, LayoutParams(dpToPx(32), dpToPx(32)))
+
+        mediaContentLayout.addView(controlsLayout, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+        rootLayout.addView(mediaContentLayout, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+
+        setOnClickListener {
+            currentEvent?.intent?.let { pendingIntent ->
+                try { pendingIntent.send() } catch (ignored: Throwable) {}
+            }
+        }
+    }
+
+    fun updateCardBackground() {
+        background = GradientDrawable().apply {
+            cornerRadius = dpToPx(20).toFloat()
+            setColor(Color.parseColor("#26FFFFFF"))
+            setStroke(dpToPx(1), Color.parseColor("#1FFFFFFF"))
+        }
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        IslandController.instance?.addMediaListener(mediaListener)
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        IslandController.instance?.removeMediaListener(mediaListener)
+    }
+
+    fun bindMediaEvent(event: IslandEvent?) {
+        currentEvent = event
+        if (event == null) {
+            placeholderLayout.visibility = View.VISIBLE
+            mediaContentLayout.visibility = View.GONE
+            return
+        }
+
+        placeholderLayout.visibility = View.GONE
+        mediaContentLayout.visibility = View.VISIBLE
+
+        titleText.text = event.title
+        artistText.text = event.subtitle
+
+        if (event.customBitmap != null) {
+            albumArt.setImageBitmap(event.customBitmap)
+        } else {
+            albumArt.setImageResource(R.drawable.ic_control_center_music)
+        }
+
+        val actions = event.actions
+        if (actions.isNotEmpty()) {
+            val prevAction = actions.getOrNull(0)
+            btnPrev.setOnClickListener { executeAction(prevAction) }
+
+            val playAction = actions.getOrNull(1)
+            btnPlayPause.setOnClickListener { executeAction(playAction) }
+            btnPlayPause.setImageResource(R.drawable.ic_control_center_pause)
+
+            val nextAction = actions.getOrNull(2)
+            btnNext.setOnClickListener { executeAction(nextAction) }
+        } else {
+            btnPlayPause.setImageResource(R.drawable.ic_control_center_play)
+        }
+    }
+
+    private fun executeAction(action: IslandAction?) {
+        if (action == null) return
+        action.actionRunnable?.run()
+        action.actionIntent?.let {
+            try { it.send() } catch (ignored: Throwable) {}
+        }
+    }
+
+    private fun dpToPx(dp: Int): Int = (dp * resources.displayMetrics.density).toInt()
+}
