+package org.avium.systemui.island
+
+import android.content.Context
+import android.database.ContentObserver
+import android.net.Uri
+import android.os.Handler
+import android.os.Looper
+import android.os.UserHandle
+import android.provider.Settings
+import com.android.systemui.dagger.SysUISingleton
+import org.avium.systemui.island.model.IslandEventType
+import javax.inject.Inject
+
+@SysUISingleton
+class IslandSettings @Inject constructor(
+    private val context: Context
+) {
+    companion object {
+        const val KEY_CAPSULE_ENABLED = "status_bar_capsule_enabled"
+        const val KEY_ISLAND_ENABLED = "super_island_enabled"
+        const val KEY_DISPLAY_MODE = "island_display_mode" // 0: Both, 1: Capsule only, 2: Island only
+        const val KEY_BLUR_ENABLED = "island_blur_enabled"
+
+        const val MODE_BOTH = 0
+        const val MODE_CAPSULE_ONLY = 1
+        const val MODE_ISLAND_ONLY = 2
+    }
+
+    private val resolver = context.contentResolver
+    private val listeners = mutableListOf<() -> Unit>()
+
+    private val observer = object : ContentObserver(Handler(Looper.getMainLooper())) {
+        override fun onChange(selfChange: Boolean, uri: Uri?) {
+            listeners.forEach { it.invoke() }
+        }
+    }
+
+    fun start() {
+        registerKey(KEY_CAPSULE_ENABLED)
+        registerKey(KEY_ISLAND_ENABLED)
+        registerKey(KEY_DISPLAY_MODE)
+        registerKey(KEY_BLUR_ENABLED)
+        for (type in IslandEventType.values()) {
+            registerKey(type.settingKey)
+        }
+    }
+
+    private fun registerKey(key: String) {
+        val uri = Settings.System.getUriFor(key) ?: return
+        resolver.registerContentObserver(uri, false, observer, UserHandle.USER_ALL)
+    }
+
+    fun addListener(listener: () -> Unit) {
+        listeners.add(listener)
+    }
+
+    val isCapsuleEnabled: Boolean
+        get() {
+            val global = Settings.System.getIntForUser(resolver, KEY_CAPSULE_ENABLED, 1, UserHandle.USER_CURRENT) == 1
+            val mode = displayMode
+            return global && (mode == MODE_BOTH || mode == MODE_CAPSULE_ONLY)
+        }
+
+    val isIslandEnabled: Boolean
+        get() {
+            val global = Settings.System.getIntForUser(resolver, KEY_ISLAND_ENABLED, 1, UserHandle.USER_CURRENT) == 1
+            val mode = displayMode
+            return global && (mode == MODE_BOTH || mode == MODE_ISLAND_ONLY)
+        }
+
+    val displayMode: Int
+        get() = Settings.System.getIntForUser(resolver, KEY_DISPLAY_MODE, MODE_BOTH, UserHandle.USER_CURRENT)
+
+    val isBlurEnabled: Boolean
+        get() = Settings.System.getIntForUser(resolver, KEY_BLUR_ENABLED, 1, UserHandle.USER_CURRENT) == 1
+
+    fun isEventEnabled(type: IslandEventType): Boolean {
+        return Settings.System.getIntForUser(resolver, type.settingKey, 1, UserHandle.USER_CURRENT) == 1
+    }
+}
