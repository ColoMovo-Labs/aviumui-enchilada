+package org.avium.systemui.island.model
+
+import android.app.PendingIntent
+import android.graphics.Bitmap
+import android.graphics.drawable.Drawable
+
+data class IslandAction(
+    val iconResId: Int,
+    val contentDescription: String,
+    val actionIntent: PendingIntent? = null,
+    val actionRunnable: Runnable? = null
+)
+
+data class IslandEvent(
+    val id: String,
+    val type: IslandEventType,
+    val title: String,
+    val subtitle: String? = null,
+    val iconResId: Int = 0,
+    val iconDrawable: Drawable? = null,
+    val customBitmap: Bitmap? = null,
+    val chronometerBase: Long = 0L,
+    val isChronometerCountdown: Boolean = false,
+    val intent: PendingIntent? = null,
+    val autoDismissDurationMs: Long = 0L,
+    val isPersistent: Boolean = true,
+    val actions: List<IslandAction> = emptyList()
+) {
+    val priority: Int get() = type.priority
+}
