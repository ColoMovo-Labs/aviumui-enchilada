+package org.avium.systemui.island.ui
+
+import android.animation.Animator
+import android.animation.AnimatorListenerAdapter
+import android.content.Context
+import android.content.res.ColorStateList
+import android.graphics.Rect
+import android.util.AttributeSet
+import android.view.LayoutInflater
+import android.view.View
+import android.view.animation.PathInterpolator
+import android.widget.Chronometer
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import com.android.systemui.plugins.DarkIconDispatcher
+import com.android.systemui.res.R
+import org.avium.systemui.island.IslandController
+import org.avium.systemui.island.model.IslandEvent
+import org.avium.systemui.island.model.IslandEventType
+import java.util.ArrayList
+
+class StatusBarCapsuleView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0
+) : FrameLayout(context, attrs, defStyleAttr), DarkIconDispatcher.DarkReceiver {
+
+    private val container: LinearLayout
+    private val iconView: ImageView
+    private val equalizerView: EqualizerView
+    private val textView: TextView
+    private val chronometerView: Chronometer
+
+    private var currentEvent: IslandEvent? = null
+    private val springInterpolator = PathInterpolator(0.18f, 0.9f, 0.2f, 1.05f)
+
+    init {
+        LayoutInflater.from(context).inflate(R.layout.status_bar_capsule_view, this, true)
+        container = findViewById(R.id.capsule_container)
+        iconView = findViewById(R.id.capsule_icon)
+        equalizerView = findViewById(R.id.capsule_equalizer)
+        textView = findViewById(R.id.capsule_text)
+        chronometerView = findViewById(R.id.capsule_chronometer)
+
+        setOnClickListener {
+            IslandController.instance?.onCapsuleClicked()
+        }
+        setOnLongClickListener {
+            currentEvent?.intent?.let { pendingIntent ->
+                try {
+                    pendingIntent.send()
+                    return@setOnLongClickListener true
+                } catch (ignored: Throwable) {}
+            }
+            false
+        }
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        IslandController.instance?.setCapsuleView(this)
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        IslandController.instance?.setCapsuleView(null)
+    }
+
+    override fun onDarkChanged(areas: ArrayList<Rect>?, darkIntensity: Float, tint: Int) {
+        // High contrast on dark capsule background; tint icon if light
+        iconView.imageTintList = ColorStateList.valueOf(0xFFFFFFFF.toInt())
+        textView.setTextColor(0xFFFFFFFF.toInt())
+        chronometerView.setTextColor(0xFFFFFFFF.toInt())
+    }
+
+    fun bindEvent(event: IslandEvent?) {
+        if (event == null) {
+            if (visibility != View.GONE) {
+                animate()
+                    .alpha(0f)
+                    .scaleX(0.85f)
+                    .scaleY(0.85f)
+                    .setDuration(220L)
+                    .setInterpolator(springInterpolator)
+                    .setListener(object : AnimatorListenerAdapter() {
+                        override fun onAnimationEnd(animation: Animator) {
+                            visibility = View.GONE
+                            currentEvent = null
+                            equalizerView.setPlaying(false)
+                            chronometerView.stop()
+                        }
+                    })
+                    .start()
+            }
+            return
+        }
+
+        val isNew = currentEvent == null
+        currentEvent = event
+
+        // Icon setup
+        if (event.iconResId != 0) {
+            iconView.setImageResource(event.iconResId)
+            iconView.visibility = View.VISIBLE
+        } else if (event.iconDrawable != null) {
+            iconView.setImageDrawable(event.iconDrawable)
+            iconView.visibility = View.VISIBLE
+        } else {
+            iconView.visibility = View.GONE
+        }
+
+        // Equalizer vs Chronometer vs Text
+        if (event.type == IslandEventType.MEDIA) {
+            equalizerView.visibility = View.VISIBLE
+            equalizerView.setPlaying(true)
+            chronometerView.visibility = View.GONE
+            textView.visibility = View.VISIBLE
+            textView.text = event.title
+            textView.isSelected = true
+        } else if (event.chronometerBase > 0L) {
+            equalizerView.visibility = View.GONE
+            equalizerView.setPlaying(false)
+            textView.visibility = View.GONE
+            chronometerView.visibility = View.VISIBLE
+            chronometerView.base = event.chronometerBase
+            chronometerView.isCountDown = event.isChronometerCountdown
+            chronometerView.start()
+        } else {
+            equalizerView.visibility = View.GONE
+            equalizerView.setPlaying(false)
+            chronometerView.visibility = View.GONE
+            textView.visibility = View.VISIBLE
+            textView.text = event.title
+            textView.isSelected = true
+        }
+
+        if (isNew || visibility != View.VISIBLE) {
+            visibility = View.VISIBLE
+            alpha = 0f
+            scaleX = 0.85f
+            scaleY = 0.85f
+            animate()
+                .alpha(1f)
+                .scaleX(1f)
+                .scaleY(1f)
+                .setDuration(320L)
+                .setInterpolator(springInterpolator)
+                .setListener(null)
+                .start()
+        }
+    }
+}
