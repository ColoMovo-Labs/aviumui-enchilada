+package org.avium.systemui.island.monitors
+
+import android.content.Context
+import android.graphics.Bitmap
+import androidx.core.graphics.drawable.toBitmap
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.media.controls.domain.pipeline.MediaDataManager
+import com.android.systemui.media.controls.shared.model.MediaData
+import com.android.systemui.res.R
+import org.avium.systemui.island.model.IslandAction
+import org.avium.systemui.island.model.IslandEvent
+import org.avium.systemui.island.model.IslandEventType
+import javax.inject.Inject
+
+@SysUISingleton
+class MediaEventMonitor @Inject constructor(
+    private val context: Context,
+    private val mediaDataManager: MediaDataManager
+) : MediaDataManager.Listener {
+
+    interface Callback {
+        fun onEventUpdated(event: IslandEvent)
+        fun onEventDismissed(id: String)
+    }
+
+    private var callback: Callback? = null
+    private var lastSongTitle: String? = null
+
+    fun start(callback: Callback) {
+        this.callback = callback
+        mediaDataManager.addListener(this)
+    }
+
+    override fun onMediaDataLoaded(
+        key: String,
+        oldKey: String?,
+        data: MediaData,
+        immediately: Boolean
+    ) {
+        if (data.isPlaying == true) {
+            val song = data.song?.toString() ?: "Playing"
+            val artist = data.artist?.toString() ?: ""
+            val isNewSong = lastSongTitle != song
+            lastSongTitle = song
+
+            var artworkBitmap: Bitmap? = null
+            try {
+                artworkBitmap = data.artwork?.loadDrawable(context)?.toBitmap(128, 128)
+            } catch (ignored: Throwable) {}
+
+            val actions = mutableListOf<IslandAction>()
+
+            val semantic = data.semanticActions
+            if (semantic != null) {
+                semantic.prevOrCustom?.let { act ->
+                    actions.add(IslandAction(
+                        iconResId = R.drawable.ic_island_skip_prev,
+                        contentDescription = "Previous",
+                        actionRunnable = act.action
+                    ))
+                }
+                semantic.playOrPause?.let { act ->
+                    actions.add(IslandAction(
+                        iconResId = R.drawable.ic_island_pause,
+                        contentDescription = "Pause",
+                        actionRunnable = act.action
+                    ))
+                }
+                semantic.nextOrCustom?.let { act ->
+                    actions.add(IslandAction(
+                        iconResId = R.drawable.ic_island_skip_next,
+                        contentDescription = "Next",
+                        actionRunnable = act.action
+                    ))
+                }
+            } else if (data.actions.isNotEmpty()) {
+                for (notifAction in data.actions.take(3)) {
+                    actions.add(IslandAction(
+                        iconResId = R.drawable.ic_island_music,
+                        contentDescription = notifAction.contentDescription?.toString() ?: "Action",
+                        actionIntent = notifAction.actionIntent
+                    ))
+                }
+            }
+
+            val event = IslandEvent(
+                id = "media",
+                type = IslandEventType.MEDIA,
+                title = song,
+                subtitle = artist,
+                iconResId = R.drawable.ic_island_music,
+                customBitmap = artworkBitmap,
+                intent = data.clickIntent,
+                autoDismissDurationMs = if (isNewSong) 3500L else 0L,
+                isPersistent = true,
+                actions = actions
+            )
+            callback?.onEventUpdated(event)
+        } else {
+            callback?.onEventDismissed("media")
+        }
+    }
+
+    override fun onMediaDataRemoved(key: String, userInitiated: Boolean) {
+        callback?.onEventDismissed("media")
+    }
+}
