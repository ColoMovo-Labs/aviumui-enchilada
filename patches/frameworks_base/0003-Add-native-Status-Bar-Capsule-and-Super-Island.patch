+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.avium.systemui.island
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import com.android.systemui.CoreStartable
+import com.android.systemui.dagger.SysUISingleton
+import org.avium.systemui.island.model.IslandEvent
+import org.avium.systemui.island.model.IslandEventType
+import org.avium.systemui.island.monitors.CallEventMonitor
+import org.avium.systemui.island.monitors.ChargingEventMonitor
+import org.avium.systemui.island.monitors.FlashlightEventMonitor
+import org.avium.systemui.island.monitors.HeadsetEventMonitor
+import org.avium.systemui.island.monitors.MediaEventMonitor
+import org.avium.systemui.island.monitors.ScreenRecordEventMonitor
+import org.avium.systemui.island.ui.StatusBarCapsuleView
+import java.util.concurrent.ConcurrentHashMap
+import javax.inject.Inject
+
+@SysUISingleton
+class IslandController @Inject constructor(
+    private val context: Context,
+    private val islandSettings: IslandSettings,
+    private val windowController: IslandWindowController,
+    private val chargingMonitor: ChargingEventMonitor,
+    private val mediaMonitor: MediaEventMonitor,
+    private val headsetMonitor: HeadsetEventMonitor,
+    private val callMonitor: CallEventMonitor,
+    private val screenRecordMonitor: ScreenRecordEventMonitor,
+    private val flashlightMonitor: FlashlightEventMonitor
+) : CoreStartable {
+
+    companion object {
+        var instance: IslandController? = null
+            private set
+    }
+
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private val activeEvents = ConcurrentHashMap<IslandEventType, IslandEvent>()
+    private var capsuleView: StatusBarCapsuleView? = null
+    private var currentActiveEvent: IslandEvent? = null
+
+    init {
+        instance = this
+    }
+
+    override fun start() {
+        islandSettings.start()
+        windowController.start()
+
+        islandSettings.addListener {
+            mainHandler.post { updateAll() }
+        }
+
+        // Monitors callbacks
+        val chargingCallback = object : ChargingEventMonitor.Callback {
+            override fun onEventUpdated(event: IslandEvent) { handleEventUpdated(event) }
+            override fun onEventDismissed(id: String) { handleEventDismissed(IslandEventType.CHARGING) }
+        }
+        chargingMonitor.start(chargingCallback)
+
+        val mediaCallback = object : MediaEventMonitor.Callback {
+            override fun onEventUpdated(event: IslandEvent) { handleEventUpdated(event) }
+            override fun onEventDismissed(id: String) { handleEventDismissed(IslandEventType.MEDIA) }
+        }
+        mediaMonitor.start(mediaCallback)
+
+        val headsetCallback = object : HeadsetEventMonitor.Callback {
+            override fun onEventUpdated(event: IslandEvent) { handleEventUpdated(event) }
+            override fun onEventDismissed(id: String) { handleEventDismissed(IslandEventType.HEADSET) }
+        }
+        headsetMonitor.start(headsetCallback)
+
+        val callCallback = object : CallEventMonitor.Callback {
+            override fun onEventUpdated(event: IslandEvent) { handleEventUpdated(event) }
+            override fun onEventDismissed(id: String) { handleEventDismissed(IslandEventType.CALL) }
+        }
+        callMonitor.start(callCallback)
+
+        val screenRecordCallback = object : ScreenRecordEventMonitor.Callback {
+            override fun onEventUpdated(event: IslandEvent) { handleEventUpdated(event) }
+            override fun onEventDismissed(id: String) { handleEventDismissed(IslandEventType.RECORDING) }
+        }
+        screenRecordMonitor.start(screenRecordCallback)
+
+        val flashlightCallback = object : FlashlightEventMonitor.Callback {
+            override fun onEventUpdated(event: IslandEvent) { handleEventUpdated(event) }
+            override fun onEventDismissed(id: String) { handleEventDismissed(IslandEventType.FLASHLIGHT) }
+        }
+        flashlightMonitor.start(flashlightCallback)
+    }
+
+    fun setCapsuleView(view: StatusBarCapsuleView?) {
+        capsuleView = view
+        mainHandler.post { updateCapsule() }
+    }
+
+    private fun handleEventUpdated(event: IslandEvent) {
+        if (!islandSettings.isEventEnabled(event.type)) {
+            activeEvents.remove(event.type)
+            mainHandler.post { updateAll() }
+            return
+        }
+
+        activeEvents[event.type] = event
+        mainHandler.post {
+            updateAll()
+            if (event.autoDismissDurationMs > 0L && islandSettings.isIslandEnabled) {
+                windowController.showEvent(event, autoExpand = true)
+            }
+        }
+    }
+
+    private fun handleEventDismissed(type: IslandEventType) {
+        activeEvents.remove(type)
+        mainHandler.post { updateAll() }
+    }
+
+    private fun updateAll() {
+        val top = getTopEvent()
+        currentActiveEvent = top
+        updateCapsule()
+        if (top == null) {
+            windowController.collapse()
+        }
+    }
+
+    private fun updateCapsule() {
+        val top = currentActiveEvent
+        if (islandSettings.isCapsuleEnabled && top != null) {
+            capsuleView?.bindEvent(top)
+        } else {
+            capsuleView?.bindEvent(null)
+        }
+    }
+
+    private fun getTopEvent(): IslandEvent? {
+        return activeEvents.values
+            .filter { islandSettings.isEventEnabled(it.type) }
+            .minByOrNull { it.priority }
+    }
+
+    fun onCapsuleClicked() {
+        val top = currentActiveEvent ?: getTopEvent() ?: return
+        if (islandSettings.isIslandEnabled) {
+            windowController.showEvent(top, autoExpand = true)
+        } else {
+            top.intent?.let {
+                try { it.send() } catch (ignored: Throwable) {}
+            }
+        }
+    }
+
+    fun collapseIsland() {
+        windowController.collapse()
+    }
+
+    fun cycleEvent(forward: Boolean) {
+        val events = activeEvents.values
+            .filter { islandSettings.isEventEnabled(it.type) }
+            .sortedBy { it.priority }
+        if (events.size <= 1) return
+
+        val currentIndex = events.indexOf(currentActiveEvent)
+        val nextIndex = if (forward) {
+            (currentIndex + 1) % events.size
+        } else {
+            if (currentIndex <= 0) events.size - 1 else currentIndex - 1
+        }
+        val nextEvent = events[nextIndex]
+        currentActiveEvent = nextEvent
+        updateCapsule()
+        windowController.showEvent(nextEvent, autoExpand = false)
+    }
+}
