+package org.avium.systemui.island.monitors
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.BatteryManager
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.res.R
+import com.android.systemui.statusbar.policy.BatteryController
+import org.avium.systemui.island.model.IslandEvent
+import org.avium.systemui.island.model.IslandEventType
+import javax.inject.Inject
+
+@SysUISingleton
+class ChargingEventMonitor @Inject constructor(
+    private val context: Context,
+    private val batteryController: BatteryController
+) : BatteryController.BatteryStateChangeCallback {
+
+    interface Callback {
+        fun onEventUpdated(event: IslandEvent)
+        fun onEventDismissed(id: String)
+    }
+
+    private var callback: Callback? = null
+    private var lastPluggedIn = false
+    private var isFastCharging = false
+
+    private val batteryReceiver = object : BroadcastReceiver() {
+        override fun onReceive(context: Context?, intent: Intent?) {
+            intent ?: return
+            if (Intent.ACTION_BATTERY_CHANGED == intent.action) {
+                val status = intent.getIntExtra(BatteryManager.EXTRA_STATUS, -1)
+                val plugged = intent.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) != 0
+                val chargeSpeed = intent.getIntExtra("charge_counter", 0)
+                val fastStatus = intent.getIntExtra("fastcharge_status", 0)
+                isFastCharging = fastStatus > 0 || chargeSpeed > 2000000
+
+                val level = intent.getIntExtra(BatteryManager.EXTRA_LEVEL, -1)
+                val scale = intent.getIntExtra(BatteryManager.EXTRA_SCALE, -1)
+                val batteryPct = if (level >= 0 && scale > 0) (level * 100 / scale) else level
+
+                if (plugged) {
+                    notifyCharging(batteryPct, isFastCharging, triggerExpand = !lastPluggedIn)
+                } else if (lastPluggedIn) {
+                    callback?.onEventDismissed("charging")
+                }
+                lastPluggedIn = plugged
+            }
+        }
+    }
+
+    fun start(callback: Callback) {
+        this.callback = callback
+        batteryController.addCallback(this)
+        val filter = IntentFilter(Intent.ACTION_BATTERY_CHANGED)
+        context.registerReceiver(batteryReceiver, filter)
+    }
+
+    override fun onBatteryLevelChanged(level: Int, pluggedIn: Boolean, charging: Boolean) {
+        if (pluggedIn) {
+            notifyCharging(level, isFastCharging, triggerExpand = !lastPluggedIn)
+        } else if (lastPluggedIn) {
+            callback?.onEventDismissed("charging")
+        }
+        lastPluggedIn = pluggedIn
+    }
+
+    private fun notifyCharging(level: Int, fast: Boolean, triggerExpand: Boolean) {
+        val label = if (fast) "Dash Charge" else "Charging"
+        val event = IslandEvent(
+            id = "charging",
+            type = IslandEventType.CHARGING,
+            title = "$level%",
+            subtitle = "$label • Battery",
+            iconResId = R.drawable.ic_island_charging,
+            autoDismissDurationMs = if (triggerExpand) 3500L else 0L,
+            isPersistent = true
+        )
+        callback?.onEventUpdated(event)
+    }
+}
