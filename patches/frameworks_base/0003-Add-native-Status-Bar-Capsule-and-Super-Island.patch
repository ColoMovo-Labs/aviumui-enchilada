+package org.avium.systemui.island.monitors
+
+import android.content.Context
+import android.os.SystemClock
+import android.telecom.TelecomManager
+import android.telephony.TelephonyCallback
+import android.telephony.TelephonyManager
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.res.R
+import org.avium.systemui.island.model.IslandAction
+import org.avium.systemui.island.model.IslandEvent
+import org.avium.systemui.island.model.IslandEventType
+import javax.inject.Inject
+
+@SysUISingleton
+class CallEventMonitor @Inject constructor(
+    private val context: Context
+) {
+
+    interface Callback {
+        fun onEventUpdated(event: IslandEvent)
+        fun onEventDismissed(id: String)
+    }
+
+    private var callback: Callback? = null
+    private var callStartTime = 0L
+
+    private val telephonyCallback = object : TelephonyCallback(), TelephonyCallback.CallStateListener {
+        override fun onCallStateChanged(state: Int) {
+            when (state) {
+                TelephonyManager.CALL_STATE_OFFHOOK -> {
+                    if (callStartTime == 0L) {
+                        callStartTime = SystemClock.elapsedRealtime()
+                    }
+                    val actions = listOf(
+                        IslandAction(
+                            iconResId = R.drawable.ic_island_call_end,
+                            contentDescription = "End Call",
+                            actionRunnable = {
+                                try {
+                                    val telecom = context.getSystemService(TelecomManager::class.java)
+                                    telecom?.endCall()
+                                } catch (ignored: Throwable) {}
+                            }
+                        )
+                    )
+                    val event = IslandEvent(
+                        id = "call",
+                        type = IslandEventType.CALL,
+                        title = "Active Call",
+                        subtitle = "Ongoing voice call",
+                        iconResId = R.drawable.ic_island_call,
+                        chronometerBase = callStartTime,
+                        isPersistent = true,
+                        actions = actions
+                    )
+                    callback?.onEventUpdated(event)
+                }
+                TelephonyManager.CALL_STATE_IDLE -> {
+                    callStartTime = 0L
+                    callback?.onEventDismissed("call")
+                }
+            }
+        }
+    }
+
+    fun start(callback: Callback) {
+        this.callback = callback
+        try {
+            val telephonyManager = context.getSystemService(TelephonyManager::class.java)
+            telephonyManager?.registerTelephonyCallback(context.mainExecutor, telephonyCallback)
+        } catch (ignored: Throwable) {}
+    }
+}
