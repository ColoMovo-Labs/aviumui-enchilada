+ * Priority determines display ordering when multiple events are active (1 is highest).
+ */
+enum class IslandEventType(val priority: Int, val settingKey: String) {
+    PRIVACY(1, "island_event_privacy"),
+    CALL(2, "island_event_call"),
+    RECORDING(3, "island_event_recording"),
+    TIMER(4, "island_event_timer"),
+    CHARGING(5, "island_event_charging"),
+    HEADSET(6, "island_event_headset"),
+    MEDIA(7, "island_event_media"),
+    FLASHLIGHT(8, "island_event_flashlight"),
+    CLOCK(9, "island_event_clock");
