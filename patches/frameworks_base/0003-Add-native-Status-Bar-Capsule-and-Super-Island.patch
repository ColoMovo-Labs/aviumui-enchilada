+package org.avium.systemui.island.ui
+
+import android.content.Context
+import android.util.AttributeSet
+import android.view.GestureDetector
+import android.view.LayoutInflater
+import android.view.MotionEvent
+import android.view.View
+import android.widget.Chronometer
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.TextView
+import com.android.systemui.res.R
+import org.avium.systemui.island.IslandController
+import org.avium.systemui.island.model.IslandEvent
+import org.avium.systemui.island.model.IslandEventType
+import kotlin.math.abs
+
+class SuperIslandView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0
+) : FrameLayout(context, attrs, defStyleAttr) {
+
+    val card: FrameLayout
+
+    // Media
+    private val mediaLayout: View
+    private val mediaArt: ImageView
+    private val mediaTitle: TextView
+    private val mediaArtist: TextView
+    private val mediaEqualizer: EqualizerView
+    private val actionPrev: ImageView
+    private val actionPlayPause: ImageView
+    private val actionNext: ImageView
+
+    // Generic
+    private val genericLayout: View
+    private val genericIcon: ImageView
+    private val genericTitle: TextView
+    private val genericSubtitle: TextView
+    private val genericChronometer: Chronometer
+    private val genericActionBtn: TextView
+
+    private var activeEvent: IslandEvent? = null
+
+    private val gestureDetector = GestureDetector(context, object : GestureDetector.SimpleOnGestureListener() {
+        override fun onFling(
+            e1: MotionEvent?,
+            e2: MotionEvent,
+            velocityX: Float,
+            velocityY: Float
+        ): Boolean {
+            if (e1 == null) return false
+            val diffY = e2.y - e1.y
+            val diffX = e2.x - e1.x
+            if (abs(diffY) > abs(diffX) && diffY < -50 && abs(velocityY) > 100) {
+                // Swipe up: collapse
+                IslandController.instance?.collapseIsland()
+                return true
+            } else if (abs(diffX) > abs(diffY) && abs(velocityX) > 100) {
+                // Swipe horizontal: cycle event
+                if (diffX > 0) {
+                    IslandController.instance?.cycleEvent(forward = false)
+                } else {
+                    IslandController.instance?.cycleEvent(forward = true)
+                }
+                return true
+            }
+            return false
+        }
+    })
+
+    init {
+        LayoutInflater.from(context).inflate(R.layout.super_island_view, this, true)
+        card = findViewById(R.id.super_island_card)
+
+        mediaLayout = findViewById(R.id.island_media_layout)
+        mediaArt = findViewById(R.id.island_media_art)
+        mediaTitle = findViewById(R.id.island_media_title)
+        mediaArtist = findViewById(R.id.island_media_artist)
+        mediaEqualizer = findViewById(R.id.island_media_equalizer)
+        actionPrev = findViewById(R.id.island_action_prev)
+        actionPlayPause = findViewById(R.id.island_action_play_pause)
+        actionNext = findViewById(R.id.island_action_next)
+
+        genericLayout = findViewById(R.id.island_generic_layout)
+        genericIcon = findViewById(R.id.island_generic_icon)
+        genericTitle = findViewById(R.id.island_generic_title)
+        genericSubtitle = findViewById(R.id.island_generic_subtitle)
+        genericChronometer = findViewById(R.id.island_generic_chronometer)
+        genericActionBtn = findViewById(R.id.island_generic_action_btn)
+
+        card.setOnClickListener {
+            activeEvent?.intent?.let { pendingIntent ->
+                try {
+                    pendingIntent.send()
+                    IslandController.instance?.collapseIsland()
+                } catch (ignored: Throwable) {}
+            }
+        }
+    }
+
+    override fun onInterceptTouchEvent(ev: MotionEvent): Boolean {
+        gestureDetector.onTouchEvent(ev)
+        return super.onInterceptTouchEvent(ev)
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        if (gestureDetector.onTouchEvent(event)) {
+            return true
+        }
+        return super.onTouchEvent(event)
+    }
+
+    fun bindEvent(event: IslandEvent) {
+        activeEvent = event
+
+        if (event.type == IslandEventType.MEDIA) {
+            genericLayout.visibility = View.GONE
+            genericChronometer.stop()
+            mediaLayout.visibility = View.VISIBLE
+
+            mediaTitle.text = event.title
+            mediaTitle.isSelected = true
+            mediaArtist.text = event.subtitle ?: ""
+            mediaEqualizer.setPlaying(true)
+
+            if (event.customBitmap != null) {
+                mediaArt.setImageBitmap(event.customBitmap)
+            } else {
+                mediaArt.setImageResource(R.drawable.ic_island_music)
+            }
+
+            // Bind actions
+            val prevAction = event.actions.getOrNull(0)
+            val playAction = event.actions.getOrNull(1)
+            val nextAction = event.actions.getOrNull(2)
+
+            actionPrev.visibility = if (prevAction != null) View.VISIBLE else View.GONE
+            actionPrev.setOnClickListener {
+                prevAction?.actionRunnable?.run()
+                try { prevAction?.actionIntent?.send() } catch (ignored: Throwable) {}
+            }
+
+            actionPlayPause.visibility = if (playAction != null) View.VISIBLE else View.GONE
+            actionPlayPause.setOnClickListener {
+                playAction?.actionRunnable?.run()
+                try { playAction?.actionIntent?.send() } catch (ignored: Throwable) {}
+            }
+
+            actionNext.visibility = if (nextAction != null) View.VISIBLE else View.GONE
+            actionNext.setOnClickListener {
+                nextAction?.actionRunnable?.run()
+                try { nextAction?.actionIntent?.send() } catch (ignored: Throwable) {}
+            }
+        } else {
+            mediaLayout.visibility = View.GONE
+            mediaEqualizer.setPlaying(false)
+            genericLayout.visibility = View.VISIBLE
+
+            if (event.iconResId != 0) {
+                genericIcon.setImageResource(event.iconResId)
+                genericIcon.visibility = View.VISIBLE
+            } else {
+                genericIcon.visibility = View.GONE
+            }
+
+            genericTitle.text = event.title
+            genericSubtitle.text = event.subtitle ?: ""
+
+            if (event.chronometerBase > 0L) {
+                genericChronometer.visibility = View.VISIBLE
+                genericChronometer.base = event.chronometerBase
+                genericChronometer.isCountDown = event.isChronometerCountdown
+                genericChronometer.start()
+            } else {
+                genericChronometer.visibility = View.GONE
+                genericChronometer.stop()
+            }
+
+            val primaryAction = event.actions.firstOrNull()
+            if (primaryAction != null) {
+                genericActionBtn.visibility = View.VISIBLE
+                genericActionBtn.text = primaryAction.contentDescription
+                genericActionBtn.setOnClickListener {
+                    primaryAction.actionRunnable?.run()
+                    try { primaryAction.actionIntent?.send() } catch (ignored: Throwable) {}
+                    IslandController.instance?.collapseIsland()
+                }
+            } else {
+                genericActionBtn.visibility = View.GONE
+            }
+        }
+    }
+}
