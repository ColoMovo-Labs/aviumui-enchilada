+
+package org.avium.systemui.island
+
+import android.animation.Animator
+import android.animation.AnimatorListenerAdapter
+import android.animation.ValueAnimator
+import android.content.Context
+import android.content.res.Configuration
+import android.graphics.PixelFormat
+import android.graphics.Rect
+import android.graphics.RenderEffect
+import android.graphics.Shader
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemProperties
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.WindowManager
+import android.view.animation.PathInterpolator
+import android.widget.FrameLayout
+import com.android.keyguard.KeyguardUpdateMonitor
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.keyguard.WakefulnessLifecycle
+import com.android.systemui.res.R
+import org.avium.systemui.island.model.IslandEvent
+import org.avium.systemui.island.ui.SuperIslandView
+import javax.inject.Inject
+
+@SysUISingleton
+class IslandWindowController @Inject constructor(
+    private val context: Context,
+    private val keyguardUpdateMonitor: KeyguardUpdateMonitor,
+    private val wakefulnessLifecycle: WakefulnessLifecycle,
+    private val islandSettings: IslandSettings
+) {
+
+    private val windowManager = context.getSystemService(WindowManager::class.java)
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    private var overlayLayout: FrameLayout? = null
+    private var islandView: SuperIslandView? = null
+    private var isWindowAdded = false
+    private var isExpanded = false
+    private var currentAnimator: ValueAnimator? = null
+    private var autoCollapseRunnable: Runnable? = null
+
+    private val springInterpolator = PathInterpolator(0.18f, 0.9f, 0.2f, 1.05f)
+    private val collapseInterpolator = PathInterpolator(0.35f, 0f, 0.2f, 1f)
+
+    private val wakefulnessObserver = object : WakefulnessLifecycle.Observer {
+        override fun onStartedGoingToSleep() {
+            collapseImmediately()
+        }
+    }
+
+    fun start() {
+        wakefulnessLifecycle.addObserver(wakefulnessObserver)
+    }
+
+    private fun ensureWindow() {
+        if (isWindowAdded && overlayLayout != null) return
+
+        val view = object : FrameLayout(context) {
+            override fun dispatchTouchEvent(ev: MotionEvent): Boolean {
+                if (!isExpanded) return super.dispatchTouchEvent(ev)
+                val card = islandView?.card ?: return super.dispatchTouchEvent(ev)
+                val rect = Rect()
+                card.getGlobalVisibleRect(rect)
+                if (ev.action == MotionEvent.ACTION_DOWN && !rect.contains(ev.x.toInt(), ev.y.toInt())) {
+                    collapse()
+                    return true
+                }
+                return super.dispatchTouchEvent(ev)
+            }
+        }
+        overlayLayout = view
+
+        val superIsland = SuperIslandView(context)
+        islandView = superIsland
+
+        val cardLp = FrameLayout.LayoutParams(
+            FrameLayout.LayoutParams.WRAP_CONTENT,
+            FrameLayout.LayoutParams.WRAP_CONTENT
+        ).apply {
+            gravity = Gravity.TOP or Gravity.CENTER_HORIZONTAL
+            topMargin = dpToPx(6)
+        }
+        view.addView(superIsland, cardLp)
+        view.visibility = View.GONE
+
+        val lp = WindowManager.LayoutParams(
+            WindowManager.LayoutParams.MATCH_PARENT,
+            WindowManager.LayoutParams.WRAP_CONTENT,
+            WindowManager.LayoutParams.TYPE_STATUS_BAR_SUB_PANEL,
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
+                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
+            PixelFormat.TRANSLUCENT
+        ).apply {
+            gravity = Gravity.TOP or Gravity.CENTER_HORIZONTAL
+            layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
+            title = "SuperIslandOverlay"
+        }
+
+        try {
+            windowManager?.addView(view, lp)
+            isWindowAdded = true
+        } catch (ignored: Throwable) {}
+    }
+
+    fun showEvent(event: IslandEvent, autoExpand: Boolean) {
+        if (!islandSettings.isIslandEnabled) return
+        ensureWindow()
+        val island = islandView ?: return
+        val overlay = overlayLayout ?: return
+
+        island.bindEvent(event)
+        updateBackdropBlur(island.card)
+
+        if (autoExpand || isExpanded) {
+            expand(event.autoDismissDurationMs)
+        }
+    }
+
+    fun expand(autoDismissDurationMs: Long = 0L) {
+        if (!islandSettings.isIslandEnabled) return
+        ensureWindow()
+        val island = islandView ?: return
+        val overlay = overlayLayout ?: return
+
+        autoCollapseRunnable?.let { mainHandler.removeCallbacks(it) }
+        autoCollapseRunnable = null
+
+        val displayMetrics = context.resources.displayMetrics
+        val isPortrait = context.resources.configuration.orientation == Configuration.ORIENTATION_PORTRAIT
+
+        val screenWidth = displayMetrics.widthPixels
+        val targetWidth = if (isPortrait) (screenWidth * 0.88f).toInt().coerceAtMost(dpToPx(380)) else dpToPx(340)
+        val targetHeight = if (isPortrait) dpToPx(78) else dpToPx(66)
+
+        val card = island.card
+        card.visibility = View.VISIBLE
+        overlay.visibility = View.VISIBLE
+
+        currentAnimator?.cancel()
+        val anim = ValueAnimator.ofFloat(if (isExpanded) 1f else 0f, 1f).apply {
+            duration = 360L
+            interpolator = springInterpolator
+            addUpdateListener { va ->
+                val progress = va.animatedValue as Float
+                val w = (dpToPx(140) + (targetWidth - dpToPx(140)) * progress).toInt()
+                val h = (dpToPx(32) + (targetHeight - dpToPx(32)) * progress).toInt()
+                card.layoutParams.width = w
+                card.layoutParams.height = h
+                card.alpha = 0.5f + 0.5f * progress
+                card.scaleX = 0.9f + 0.1f * progress
+                card.scaleY = 0.9f + 0.1f * progress
+                card.requestLayout()
+            }
+            addListener(object : AnimatorListenerAdapter() {
+                override fun onAnimationEnd(animation: Animator) {
+                    isExpanded = true
+                }
+            })
+            start()
+        }
+        currentAnimator = anim
+
+        if (autoDismissDurationMs > 0L) {
+            val runnable = Runnable { collapse() }
+            autoCollapseRunnable = runnable
+            mainHandler.postDelayed(runnable, autoDismissDurationMs)
+        }
+    }
+
+    fun collapse() {
+        if (!isExpanded) return
+        val island = islandView ?: return
+        val overlay = overlayLayout ?: return
+
+        autoCollapseRunnable?.let { mainHandler.removeCallbacks(it) }
+        autoCollapseRunnable = null
+
+        val card = island.card
+        val startWidth = card.width
+        val startHeight = card.height
+
+        currentAnimator?.cancel()
+        val anim = ValueAnimator.ofFloat(1f, 0f).apply {
+            duration = 240L
+            interpolator = collapseInterpolator
+            addUpdateListener { va ->
+                val progress = va.animatedValue as Float
+                val w = (dpToPx(120) + (startWidth - dpToPx(120)) * progress).toInt()
+                val h = (dpToPx(28) + (startHeight - dpToPx(28)) * progress).toInt()
+                card.layoutParams.width = w
+                card.layoutParams.height = h
+                card.alpha = progress
+                card.scaleX = 0.85f + 0.15f * progress
+                card.scaleY = 0.85f + 0.15f * progress
+                card.requestLayout()
+            }
+            addListener(object : AnimatorListenerAdapter() {
+                override fun onAnimationEnd(animation: Animator) {
+                    isExpanded = false
+                    overlay.visibility = View.GONE
+                }
+            })
+            start()
+        }
+        currentAnimator = anim
+    }
+
+    fun collapseImmediately() {
+        autoCollapseRunnable?.let { mainHandler.removeCallbacks(it) }
+        autoCollapseRunnable = null
+        currentAnimator?.cancel()
+        isExpanded = false
+        overlayLayout?.visibility = View.GONE
+    }
+
+    private fun updateBackdropBlur(view: View) {
+        val supportsBlur = SystemProperties.getBoolean("ro.surface_flinger.supports_background_blur", false)
+        val blurEnabled = islandSettings.isBlurEnabled
+        if (supportsBlur && blurEnabled && Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            try {
+                view.setRenderEffect(RenderEffect.createBlurEffect(50f, 50f, Shader.TileMode.CLAMP))
+                view.setBackgroundResource(R.drawable.super_island_bg_blur)
+                return
+            } catch (ignored: Throwable) {}
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            try { view.setRenderEffect(null) } catch (ignored: Throwable) {}
+        }
+        view.setBackgroundResource(R.drawable.super_island_bg)
+    }
+
+    private fun dpToPx(dp: Int): Int {
+        return (dp * context.resources.displayMetrics.density).toInt()
+    }
+}
