+    private fun bindListPreference(
+        prefKey: String,
+        settingKey: String,
+        table: SettingTable,
+        defaultValue: Int = 0
+    ) {
+        val pref = findPreference<androidx.preference.ListPreference>(prefKey) ?: return
+        val resolver = requireContext().contentResolver
+        val currentValue = when (table) {
+            SettingTable.SYSTEM -> Settings.System.getInt(resolver, settingKey, defaultValue)
+            SettingTable.SECURE -> Settings.Secure.getInt(resolver, settingKey, defaultValue)
+        }
+        pref.isPersistent = false
+        pref.value = currentValue.toString()
+        pref.summary = "%s"
+        pref.onPreferenceChangeListener = Preference.OnPreferenceChangeListener { _, newValue ->
+            val value = (newValue as String).toIntOrNull() ?: defaultValue
+            when (table) {
+                SettingTable.SYSTEM -> Settings.System.putInt(resolver, settingKey, value)
+                SettingTable.SECURE -> Settings.Secure.putInt(resolver, settingKey, value)
+            }
+            true
+        }
+    }
